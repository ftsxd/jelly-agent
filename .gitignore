# 规划文档（不入库）
ADK-Go-Agent平台-完整方案规划v2.docx
PLAN.md
OPTIMIZATION.md

# Go 构建产物
/jelly
/jelly-agent
/jelly-cli
/cli
/adk-platform
*.exe
*.test
*.out

# 本地配置与数据
*.local.yaml
/configs/config.yaml      # 真实配置（可能含 key），只追踪 config.example.yaml
~/.jelly-agent/
/data/
*.db
*.sqlite

# 依赖与环境
vendor/
.env

# 前端
web/node_modules/
# dist 是构建产物，不入库；保留 .gitkeep 让 //go:embed all:dist 在未构建时也能编译
web/dist/*
!web/dist/.gitkeep

# 其他会话在这个目录里干活留下的产物（述职材料、表格整理等），和本仓库无关。
# 这里是 Claude Code 的工作目录，不代表这些文件属于这个项目。
/outputs/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
