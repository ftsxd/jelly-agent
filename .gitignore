# 规划文档（不入库）
ADK-Go-Agent平台-完整方案规划v2.docx
PLAN.md
OPTIMIZATION.md

# Go 构建产物
/jelly
/jelly-agent
/jelly-cli
/cli
/adk-platform
*.exe
*.test
*.out

# 本地配置与数据
*.local.yaml
/configs/config.yaml      # 真实配置（可能含 key），只追踪 config.example.yaml
~/.jelly-agent/
/data/
*.db
*.sqlite

# 依赖与环境
vendor/
.env

# 前端
web/node_modules/
# dist 是构建产物，不入库；保留 .gitkeep 让 //go:embed all:dist 在未构建时也能编译
web/dist/*
!web/dist/.gitkeep

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
